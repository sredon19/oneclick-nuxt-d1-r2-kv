# Cloudflare Configuration (optional, used by drizzle-kit and wrangler)
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token
# CLOUDFLARE_D1_DATABASE_ID=your-d1-database-id

# Hyperdrive Connection String (PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/database

# Application Environment
ENVIRONMENT=development

# Better Auth
# BETTER_AUTH_URL should match your app origin (for local wrangler dev this is usually http://localhost:8787)
BETTER_AUTH_URL=http://localhost:8787

# OAuth (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Use a long random secret in production
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
